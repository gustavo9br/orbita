TZ=America/Sao_Paulo

# Acesso ao sistema
APP_PASSWORD=
SESSION_SECRET=

# IA (uma das duas)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
ANTHROPIC_API_KEY=
AI_PROVIDER=

# Integrações (opcionais)
GOOGLE_CALENDAR_ICS_URL=
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
