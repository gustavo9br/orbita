# Porta em que o backend sobe
PORT=3001

# Fuso usado pra calcular "hoje", semanas e o painel
TZ=America/Sao_Paulo

# Senha única de acesso ao sistema (é um sistema pessoal, um usuário só)
APP_PASSWORD=troque-esta-senha
# Segredo usado pra assinar o cookie de sessão (qualquer string longa e aleatória)
SESSION_SECRET=troque-por-uma-string-longa-e-aleatoria

# Onde fica o arquivo SQLite
DB_PATH=./data/orbita.db

# IA — defina UMA das chaves. Sem nenhuma, o sistema funciona, mas as funções de IA caem num modo heurístico simples.
# OpenAI: platform.openai.com → API keys. OPENAI_MODEL é opcional (padrão: gpt-5.4-mini, barato e rápido).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Anthropic (Claude): console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Se as duas estiverem definidas, force uma: openai | anthropic
AI_PROVIDER=

# Google Agenda — "Endereço secreto no formato iCal" da agenda (Configurações da agenda > Integrar agenda)
GOOGLE_CALENDAR_ICS_URL=

# Notion — token de uma integração interna + ID de uma página compartilhada com ela.
# Na primeira sincronização o sistema cria o banco "Órbita — Tarefas" dentro dessa página.
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
